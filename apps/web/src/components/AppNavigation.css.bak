
/* Career Club Connect — Shared Navigation */

/* Desktop sidebar */

.app-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 238px;
  background: #ffffff;
  border-right: 1px solid #dce4ed;
  display: flex;
  flex-direction: column;
  padding: 24px 14px;
  z-index: 40;
}

.app-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 10px 30px;
  color: #102b4e;
  text-decoration: none;
  font-size: 16px;
  font-weight: 750;
  line-height: 1.25;
}

.app-brand strong {
  display: block;
  color: #1769e0;
}

.app-brand-mark {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #1769e0;
  color: white;
  font-size: 14px;
  font-weight: 800;
}

.app-nav-links {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.app-nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 10px;
  color: #253b60;
  text-decoration: none;
  font-size: 14px;
  font-weight: 550;
}

.app-nav-link:hover:not(.disabled) {
  background: #eef4fc;
}

.app-nav-link.active {
  background: #1769e0;
  color: #ffffff;
}

.app-nav-icon {
  width: 24px;
  font-size: 20px;
  text-align: center;
}

.app-nav-link.disabled {
  opacity: 0.48;
  cursor: not-allowed;
}

.app-sidebar-footer {
  margin-top: auto;
  padding: 16px 12px;
  border-top: 1px solid #dce4ed;
  font-size: 12px;
  color: #5c6b7c;
}

.app-sidebar-footer small {
  display: block;
  font-size: 11px;
}

/* Hidden on desktop */

.app-bottom-nav {
  display: none;
}

/* Mobile navigation */

@media (max-width: 768px) {
  .app-sidebar {
    display: none;
  }

  .app-bottom-nav {
    position: fixed;
    inset: auto 0 0 0;
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    padding: 8px 4px calc(8px + env(safe-area-inset-bottom));
    background: #ffffff;
    border-top: 1px solid #dce4ed;
    box-shadow: 0 -4px 20px rgba(16, 43, 78, 0.05);
    z-index: 50;
  }

  .app-bottom-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 0;
    color: #53647f;
    text-decoration: none;
    font-size: 21px;
    line-height: 1.2;
  }

  .app-bottom-link small {
    font-size: 9px;
    line-height: 1.3;
    color: inherit;
    text-align: center;
  }

  .app-bottom-link.active {
    color: #1769e0;
    font-weight: 700;
  }

  .app-bottom-link.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
}
